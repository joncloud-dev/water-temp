# Released oscore-server version to run (an image tag, without the leading "v").
# See https://github.com/joncloud-dev/oscore-server/releases
OSCORE_SERVER_VERSION=0.1.0-preview.2

# 32-byte hex key-encryption key for OSCORE master secrets: openssl rand -hex 32
# Keep it stable and secret. Losing or changing it orphans every station's keys.
PB_OSCORE_KEK=

# Telemetry retention in days (0 disables pruning).
PB_RETENTION_DAYS=90

# Host ports (container ports stay 8090/tcp and 5683/udp).
HTTP_PORT=8090
COAP_PORT=5683
